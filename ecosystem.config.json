{
  "apps": [
    {
      "name": "payband-mcp",
      "script": "payband-mcp",
      "interpreter": "none",
      "args": "--http --host 127.0.0.1 --port 8790",
      "autorestart": true,
      "max_restarts": 10,
      "restart_delay": 2000,
      "kill_timeout": 5000,
      "env": {
        "PAYBAND_CACHE_TTL": "21600"
      }
    }
  ]
}
